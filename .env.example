# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# Nothing here is required for the site to build or run. The enquiry form
# degrades in a defined order:
#
#   RESEND_API_KEY set    -> delivered via Resend (what you want)
#   nothing set           -> relayed via FormSubmit, which will not deliver
#                            anything until someone clicks the one-time
#                            activation link it emails to ENQUIRY_TO
#
# ---------------------------------------------------------------------------

# Resend API key. Create one at https://resend.com/api-keys
# Needs only the "Sending access" permission.
RESEND_API_KEY=

# Where enquiries land. Defaults to werable.disability@gmail.com if unset.
ENQUIRY_TO=werable.disability@gmail.com

# The From address on the enquiry email.
#
# IMPORTANT: this must be on a domain verified in Resend
# (https://resend.com/domains). Until werable.com.au is verified, Resend will
# only accept the shared sandbox sender below, and it will only deliver to the
# email address that owns the Resend account — not to the WE R ABLE inbox.
#
# So: verify werable.com.au, then set this to something on that domain.
#   ENQUIRY_FROM=WE R ABLE website <enquiries@werable.com.au>
ENQUIRY_FROM=WE R ABLE website <onboarding@resend.dev>
